# Copy to .env for local testing. In production, set these in
# Vercel > Project > Settings > Environment Variables.

# Web app URL of the deployed Google Apps Script (see google-apps-script/Code.gs)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# A long random string. Must match FORM_SECRET in the Apps Script properties.
FORM_SECRET=replace-with-a-long-random-string
